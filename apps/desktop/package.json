{
  "name": "@desk-events/desktop",
  "version": "0.1.0",
  "private": true,

  "description": "Escritório de Agentes — aplicativo para Windows",
  "author": "MedCof Eventos",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p electron",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "br.com.medcof.deskevents",
    "productName": "Escritório de Agentes",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
